# =====================================================================
# DVC
# =====================================================================
# NOTE: DO commit *.dvc files, dvc.yaml, dvc.lock, .dvcignore and
# .dvc/config. DVC also appends tracked data paths to .gitignore
# automatically (e.g. /data/raw) when you run `dvc add`.

/.dvc/cache
/.dvc/tmp
/.dvc/plots
/.dvc/config.local
/.dvc/tmp/
# Local DVC experiment temp dirs
.dvc/tmp/exps/

